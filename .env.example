# MoleculeLab Environment Configuration Example
# Copy this file to .env and adjust variables as needed

# Application
APP_NAME=MoleculeLab
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# Backend Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database
# Default for development/testing: SQLite. For production: PostgreSQL
DATABASE_URL=sqlite:///./moleculelab.db
# PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/moleculelab

# Security & Limits
MAX_UPLOAD_SIZE_BYTES=10485760 # 10 MB
MAX_IMPORT_ROWS=5000

# Frontend Next.js Public Env
NEXT_PUBLIC_API_URL=http://localhost:8000
